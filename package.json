{
  "name": "pamphlet-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "tsc -b --pretty false",
    "docs:dev": "pnpm themes:shots && rspress dev",
    "docs:build": "pnpm themes:shots && rspress build",
    "themes:shots": "pnpm -r build && node packages/pamphlet/scripts/theme-shots.mjs",
    "skills:sync": "pnpm -r build && node packages/pamphlet/scripts/skills-sync.mjs",
    "docs:preview": "rspress preview",
    "demo:build": "pnpm -r build && node packages/pamphlet/dist/bin.js build examples/demo.md -o docs/public/demo/index.html",
    "test:engines": "pnpm -r build && vitest run test/engines.test.ts test/engine-graphviz.test.ts test/engine-packages.test.ts test/command-engine.test.ts --root packages/pamphlet"
  },
  "devDependencies": {
    "@rspress/core": "^2.0.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
