{
  "name": "@nekoleapuki/pamphlet-cli",
  "version": "0.0.2",
  "description": "把一份 Markdown 编译成自包含的单文件 HTML：不联网、图预渲染成静态 SVG、无 JavaScript 可降级",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "bin": {
    "pamphlet": "./dist/bin.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./engine-kit": "./dist/engine-kit.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@nekoleapuki/pamphlet-runtime": "workspace:*",
    "@nekoleapuki/pamphlet-themes": "workspace:*",
    "mdast-util-directive": "^3.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.0.0",
    "micromark-extension-directive": "^3.0.2",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "subset-font": "^2.7.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@nekoleapuki/pamphlet-engine-graphviz": "workspace:*",
    "@terrastruct/d2": "^0.1.33",
    "@types/fontkit": "^2.0.9",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "fontkit": "^2.0.4",
    "mermaid-isomorphic": "^3.1.0",
    "playwright": "^1.63.0"
  },
  "keywords": [
    "markdown",
    "commonmark",
    "html",
    "single-file",
    "self-contained",
    "mermaid",
    "diagram",
    "documentation",
    "static-site",
    "cli"
  ],
  "homepage": "https://lazygophers.github.io/pamphlet/",
  "bugs": "https://github.com/lazygophers/pamphlet/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazygophers/pamphlet.git",
    "directory": "packages/pamphlet"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
