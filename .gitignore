node_modules/
dist/
*.tsbuildinfo
.pnpm-store/
.ask-ui/
graphify-out/
.scratch/

# 覆盖全局 gitignore（~/.gitignore_global）里的两条规则，
# 它们会把本仓库的源码整棵树排除掉：
#   第 410 行 `packages/`   —— 那是 .NET/NuGet 的习惯，与 pnpm workspace 冲突
#   第 147 行 `*.BASE.*`    —— 那是 merge 冲突残留文件的规则，误伤 tsconfig.base.json
!packages/
!tsconfig.base.json

# Rspress 文档站的编译产物
doc_build/

# 示例产物由 Pamphlet 现编（pnpm demo:build），不进版本库
docs/public/demo/

# 主题截图由真实编译现截（pnpm themes:shots），不进版本库
docs/public/themes/
